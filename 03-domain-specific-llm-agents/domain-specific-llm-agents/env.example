# Database Configuration
# Set these environment variables for database connections in Section 3

# MySQL Database Settings
LLM_DB_HOST=localhost
LLM_DB_PORT=3306
LLM_DB_USERNAME=your_username
LLM_DB_PASSWORD=your_password
LLM_DB_NAME=your_database_name

# Web Interface Authentication (Optional)
WEB_USERNAME=admin
WEB_PASSWORD=your_web_password

# Debug Mode (Optional)
DEBUG=false

# Hugging Face Token (Optional - for private models)
# HUGGINGFACE_TOKEN=your_hf_token
